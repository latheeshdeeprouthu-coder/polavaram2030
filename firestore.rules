rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Keep this list synchronized with ADMIN_UIDS in firebase-config.js.
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'REPLACE_WITH_YOUR_ADMIN_UID'
      ];
    }
    function isStudent() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }

    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly(['uid','name','rollNumber','email','role','createdAt']);
      allow update, delete: if isAdmin();
    }

    match /rollNumbers/{rollKey} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
          == false;
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && isStudent()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.rollNumber == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.rollNumber
        && request.resource.data.keys().hasOnly(['eventId','studentUid','studentName','rollNumber','eventTitle','eventDate','createdAt']);
      allow update, delete: if isAdmin() || (signedIn() && resource.data.studentUid == request.auth.uid);
    }
  }
}